APP_NAME="IU Events Management Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_QUERIES=false
APP_URL=http://127.0.0.1:8010
APP_PORT=8010
APP_FRONTEND_URL=http://127.0.0.1:5680
APP_CDN_URL=
APP_SAAS_MODE_ENABLED=false
APP_SAAS_STRIPE_APPLICATION_FEE_PERCENT=0
APP_HOMEPAGE_VIEWS_UPDATE_BATCH_SIZE=8
APP_DISABLE_REGISTRATION=false
APP_EVENT_SPAM_CHECK_ENABLED=false
APP_EVENT_SPAM_CHECK_CONFIDENCE_THRESHOLD=0.7
APP_PLATFORM_SUPPORT_EMAIL=support@iu.edu.sa
APP_ALLOWED_INTERNAL_WEBHOOK_HOSTS=

CORS_ALLOWED_ORIGINS=*

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=single

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_ENABLE_LOGS=false
SENTRY_LOG_LEVEL=info
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=iu_events
DB_USERNAME=postgres
DB_PASSWORD=postgres

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_AUTO_TLS=false
MAIL_VERIFY_PEER=false
MAIL_FROM_ADDRESS="no-reply@events.iu.edu.sa"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_ALGO=HS256

# Google Places address autocomplete (optional)
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=
